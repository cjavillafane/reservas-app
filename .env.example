# ==========================================
# RESERVAS APP - VARIABLES DE ENTORNO
# ==========================================

# BASE DE DATOS - reservas-db
MYSQL_DATABASE=reservasdb
MYSQL_USER=reservas_user
MYSQL_PASSWORD=reservas_pass
MYSQL_ROOT_PASSWORD=reservas_root_pass

# API - reservas-api
PORT=3000
DB_HOST=reservas-db
DB_PORT=3306
DB_NAME=reservasdb
DB_USER=reservas_user
DB_PASSWORD=reservas_pass
APP_VERSION=v1
SEED_DEMO=true

# FRONTEND - reservas-frontend
API_HOST=reservas-api
API_PORT=3000
NGINX_ENVSUBST_FILTER=^API_

# PUBLICACION DE PUERTOS EN EL HOST
FRONTEND_HOST_PORT=3000
API_HOST_PORT=3001
